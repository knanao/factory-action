# Environment template for running the action locally.
#
#   cp .env.example .env    # then fill in real values
#   bun run local-action    # = local-action . src/main.ts .env
#
# .env is gitignored: never commit real keys. The local runner (@github/
# local-action) loads this file with dotenv and stubs @actions/core and
# @actions/github, so the file must provide the required action inputs and the
# GitHub context the action reads. Action inputs map to INPUT_<NAME>
# environment variables, upper case with hyphens kept: factory-api-key ->
# INPUT_FACTORY-API-KEY. Inputs that are left unset fall back to their
# defaults in action.yml, so only the required inputs need values.

# --- Required action inputs -------------------------------------------------

# Factory API key (a service account key is recommended).
INPUT_FACTORY-API-KEY=
# Token for the action's own reaction and tracking comment (a GitHub PAT).
# It is never passed to Droid.
INPUT_GITHUB-TOKEN=

# --- Run target: set exactly one of computer-id / environment-id ------------

# ID of the existing Droid Computer the session runs on. Leave empty when
# INPUT_ENVIRONMENT-ID is set.
INPUT_COMPUTER-ID=
# Factory Environment ID: provisions one unlisted computer per issue/PR and
# lane. Leave empty when INPUT_COMPUTER-ID is set.
# INPUT_ENVIRONMENT-ID=

# --- GitHub context ---------------------------------------------------------

# The repository the event belongs to, as owner/repo.
GITHUB_REPOSITORY=octocat/example
# The webhook event being simulated. Which events are supported depends on the
# mode (see src/trigger.ts): mention -> issue_comment, pull_request_review_
# comment, pull_request_review, issues; review/security/qa -> pull_request;
# cleanup -> issues or pull_request(_target) with action closed; deep-security
# and wiki -> schedule or workflow_dispatch.
GITHUB_EVENT_NAME=issue_comment
# Path to the webhook payload as JSON (what GitHub sets in GITHUB_EVENT_PATH).
# The minimal payload shape for each event is in __fixtures__/payloads.ts, or
# fetch a real event from the GitHub API.
GITHUB_EVENT_PATH=./event.json
# Optional: used only for links back to the run.
# GITHUB_RUN_ID=1
# GITHUB_SERVER_URL=https://github.com

# --- Common optional inputs (defaults come from action.yml) ------------------

# INPUT_MODE=mention
# INPUT_LANE=
# INPUT_CWD=
# INPUT_MODEL=
# INPUT_REASONING-EFFORT=
# INPUT_AUTONOMY-LEVEL=high
# INPUT_PROVISION-TIMEOUT-SEC=300
# INPUT_FACTORY-API-URL=https://api.factory.ai
