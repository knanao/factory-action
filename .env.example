# Environment for running the action locally with `bun run local-action`.
#
# Copy this file to `.env` (gitignored: never commit real keys):
#
#     cp .env.example .env
#
# The local runner (@github/local-action) loads this file with dotenv and
# stubs @actions/core and @actions/github, so it must provide the required
# action inputs and the GitHub context the action reads. Action inputs map
# to INPUT_<NAME> environment variables, upper case with hyphens kept:
# factory-api-key -> INPUT_FACTORY-API-KEY. Inputs left unset fall back to
# their defaults in action.yml.
#
# There are two ways to run:
#
# 1. Offline, against the mock APIs (no credentials, no network):
#
#     bun run qa:mock &   # mock Factory + GitHub APIs on 127.0.0.1:4010
#     mkdir -p .qa        # the step summary below lands there
#     bun run local-action
#
#    The default values below point at the mock, so no edits are needed.
#    Repeat runs against a live mock exercise the session-reuse path (the
#    tracking comment from the first run is found and updated). For scripted
#    runs with the committed bundle prefer `bun run qa:run` (see
#    CONTRIBUTING.md, Trying the action locally).
#
# 2. For real, against a real Factory account and repository:
#    - replace the two required tokens and the computer id
#    - set INPUT_FACTORY-API-URL=https://api.factory.ai and
#      GITHUB_API_URL=https://api.github.com
#    - point GITHUB_REPOSITORY at `<owner>/<repo>` and GITHUB_EVENT_PATH at a
#      webhook payload of that repository (e.g. the event JSON of a real
#      workflow run, or a copy of script/qa/events/issue_comment.mention.json
#      edited for it)
#
# `bun run local-action` goes through script/qa/local-action.ts, which works
# around two local-action quirks under Bun: its script runner would
# otherwise shadow `node` with a shim that stalls the toolchain, and the
# @actions/github stub captures GITHUB_API_URL before this file is applied
# (the wrapper forwards it). When invoking node_modules/.bin/local-action
# directly, export GITHUB_API_URL in the shell instead.

# --- Required action inputs -------------------------------------------------

# Factory API key (a service account key is recommended; the mock accepts
# qa-factory-key).
INPUT_FACTORY-API-KEY=qa-factory-key
# Token for the action's own reaction and tracking comment (a GitHub PAT;
# the mock accepts any value).
INPUT_GITHUB-TOKEN=qa-github-token

# --- Run target: set exactly one of computer-id / environment-id ------------

# ID of the existing Droid Computer the session runs on. The mock exposes
# computer qa-computer, whose clone matches the default event below.
INPUT_COMPUTER-ID=qa-computer
# Factory Environment ID: provisions one unlisted computer per issue/PR and
# lane (mutually exclusive with computer-id). Leave unset for offline runs.
# INPUT_ENVIRONMENT-ID=

# --- Factory API ------------------------------------------------------------

# Factory API base URL: the mock server for offline runs,
# https://api.factory.ai for real ones.
INPUT_FACTORY-API-URL=http://127.0.0.1:4010

# --- GitHub context ---------------------------------------------------------

# The repository the event belongs to, as owner/repo. The default event
# below is an `@factory` mention on issue 42 of the acme/widgets demo
# repository.
GITHUB_REPOSITORY=acme/widgets
# The webhook event being simulated. Which events are supported depends on
# the mode (see src/trigger.ts): mention -> issue_comment, pull_request_
# review_comment, pull_request_review, issues; review/security/qa ->
# pull_request; cleanup -> issues or pull_request(_target) with action
# closed; deep-security and wiki -> schedule or workflow_dispatch.
GITHUB_EVENT_NAME=issue_comment
# Path to the webhook payload as JSON (what GitHub sets in GITHUB_EVENT_PATH).
GITHUB_EVENT_PATH=script/qa/events/issue_comment.mention.json
# GitHub REST API base URL: the mock server for offline runs,
# https://api.github.com for real ones.
GITHUB_API_URL=http://127.0.0.1:4010
# Used only for links back to the run.
GITHUB_SERVER_URL=https://github.com
GITHUB_RUN_ID=1
GITHUB_RUN_NUMBER=1
GITHUB_RUN_ATTEMPT=1
# The local runner writes the job summary to this file. Keep it set: a
# successful run that delegates a session writes its summary here, and the
# action fails without it.
GITHUB_STEP_SUMMARY=.qa/step-summary.md

# Emit the action's debug log locally.
ACTIONS_STEP_DEBUG=true

# --- Common optional inputs (defaults come from action.yml) ------------------

# INPUT_MODE=mention
# INPUT_LANE=
# INPUT_CWD=
# INPUT_MODEL=
# INPUT_REASONING-EFFORT=
# INPUT_AUTONOMY-LEVEL=high
# INPUT_PROVISION-TIMEOUT-SEC=300
# INPUT_MESSAGE-TIMEOUT-MS=5000
