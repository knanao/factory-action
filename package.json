{
  "name": "factory-action",
  "description": "Delegate tasks, code reviews and security reviews from GitHub to Factory Droid via the Sessions API",
  "author": "knanao",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/knanao/factory-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knanao/factory-action.git"
  },
  "bugs": {
    "url": "https://github.com/knanao/factory-action/issues"
  },
  "keywords": [
    "actions",
    "factory",
    "droid"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "bun run format:write && bun run package",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run check:static && bun run check:bundle",
    "check:agents-md": "bun script/check-agents-md.ts",
    "check:bundle": "bun script/check-bundle-size.ts",
    "check:size": "bun script/check-file-size.ts",
    "check:static": "bun run knip && bun run depcruise && bun run jscpd && bun run check:size && bun run check:todos && bun run check:agents-md",
    "check:todos": "bun script/check-todos.ts",
    "ci-test": "bun test --coverage",
    "depcruise": "depcruise src __tests__ __fixtures__ script --config .dependency-cruiser.cjs",
    "format:write": "bun fmt",
    "format:check": "bun fmt --check",
    "jscpd": "jscpd --config .jscpd.json && jscpd --config .jscpd.json --exit-code 1 src",
    "knip": "knip",
    "lint": "eslint .",
    "local-action": "bun script/qa/local-action.ts",
    "prepare": "sh script/install-hooks.sh",
    "qa:mock": "bun script/qa/mock-api.ts",
    "qa:run": "bun script/qa/run.ts",
    "package": "rm -rf dist && bun build src/index.ts --target=node --format=esm --sourcemap=linked --outdir=dist",
    "test": "bun test",
    "test:integration": "bun test __tests__/integration",
    "typecheck": "tsc --noEmit",
    "all": "bun run format:write && bun run lint && bun run typecheck && bun run check:static && bun run test && bun run package && bun run check:bundle"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@github/local-action": "^7.0.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "dependency-cruiser": "^18.7.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
